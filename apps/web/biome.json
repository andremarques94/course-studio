{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"root": false,
	"extends": ["../../biome.json"],
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**/*",
			"index.html",
			"vite.config.ts",
			"!src/routeTree.gen.ts"
		]
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnknownPseudoClass": {
					"level": "error",
					"options": {
						"ignore": ["global"]
					}
				}
			}
		}
	}
}
