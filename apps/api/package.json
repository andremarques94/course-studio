{
	"name": "@course-studio/api",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/app.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"predev": "pnpm --filter @course-studio/db build",
		"dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=../../.env dist/index.js",
		"check": "biome check",
		"format": "biome format",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/*.test.ts",
		"test:integration": "tsx --test test/api.integration.test.ts"
	},
	"dependencies": {
		"@course-studio/db": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@hono/zod-validator": "^0.7.6",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.5",
		"pino": "^9.7.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@course-studio/typescript-config": "workspace:*",
		"@types/node": "^26.1.1",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2"
	}
}
