{
	"name": "@course-studio/collab",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "pnpm --filter @course-studio/db build",
		"dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=../../.env dist/index.js",
		"check": "biome check",
		"format": "biome format",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"pretest": "pnpm --filter @course-studio/db build",
		"test": "tsx --env-file-if-exists=../../.env --test test/*.test.ts"
	},
	"dependencies": {
		"@course-studio/db": "workspace:*",
		"@hocuspocus/server": "^4.6.0",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.10",
		"pino": "^9.7.0",
		"yjs": "^13.6.32",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@course-studio/typescript-config": "workspace:*",
		"@types/node": "^26.1.1",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2"
	}
}
