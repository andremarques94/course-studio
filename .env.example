# Shared by backend applications
LOG_LEVEL=info

# apps/api — Hono HTTP API and PostgreSQL
DATABASE_URL=postgresql://course_studio:course_studio@localhost:5432/course_studio
API_PORT=3001
# Optional in development (defaults to *). Required in production; comma-separate multiple origins.
CORS_ORIGINS=http://localhost:3000

# apps/collab — Hocuspocus WebSocket server
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3002
# Internal HTTP endpoint used to initialize in-memory lesson documents in 7B.
API_URL=http://localhost:3001

# apps/web — Vite variables exposed to browser code
VITE_API_URL=http://localhost:3001
VITE_COLLAB_URL=ws://localhost:3002
