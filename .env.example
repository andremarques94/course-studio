# Shared by backend applications
LOG_LEVEL=info

# apps/api — Hono HTTP API and PostgreSQL
DATABASE_URL=postgresql://course_studio:course_studio@localhost:5432/course_studio
API_PORT=3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-stable-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
# Used by Better Auth origin checks and credentialed API CORS.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Optional GitHub OAuth. Configure both values or neither.
# Callback URL: http://localhost:3001/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional Google OAuth. Configure both values or neither.
# Callback URL: http://localhost:3001/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# apps/collab — Hocuspocus WebSocket server
# For LAN testing, use 0.0.0.0 and expose the LAN IP through VITE_COLLAB_URL.
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3002

# apps/web — Vite variables exposed to browser code
# For LAN testing, replace localhost with the development machine's LAN IP.
VITE_API_URL=http://localhost:3001
VITE_COLLAB_URL=ws://localhost:3002
